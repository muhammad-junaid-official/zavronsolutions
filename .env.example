# Copy to .env for local use, and add the same keys in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# NEVER commit real passwords — this repository is public.

SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@zavronsolutions.com
SMTP_PASS=your-titan-mailbox-password

# Optional: where new-lead notifications go (defaults to SMTP_USER)
LEAD_INBOX=info@zavronsolutions.com

# Optional: incoming mail for the admin inbox (defaults shown)
IMAP_HOST=imap.titan.email
