# Copy to .env for local use, and add the same keys in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# NEVER commit real passwords — this repository is public.

# ---- Email (SMTP) ----
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=info@zavronsolutions.com
SMTP_PASS=your-mailbox-password            # required
LEAD_INBOX=info@zavronsolutions.com        # optional: where new-lead alerts go

# ---- Admin dashboard ----
ADMIN_EMAIL=info@zavronsolutions.com       # optional (this is the default)
ADMIN_PASSWORD=choose-a-strong-password    # required to sign in at /admin/
# SESSION_SECRET=long-random-string        # optional; auto-generated and stored in the database if omitted

# ---- Database (added automatically when you connect Upstash Redis in Vercel → Storage) ----
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also supported)

# ---- Optional integrations ----
# GITHUB_TOKEN=github_pat_...   # lets "Edit SEO" save title/meta of static pages (Contents: read & write on this repo)
# OPENAI_API_KEY=sk-...         # AI chatbot replies + AI email drafts in the dashboard
